<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@style/AppThemeLight" />

    <style name="BaseAppThemeLight" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#6D28D9</item>
        <item name="android:windowBackground">#F8FAFC</item>
        <item name="android:navigationBarColor">#F8FAFC</item>
        <item name="android:statusBarColor">#F8FAFC</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="BaseAppThemeDark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#22D3EE</item>
        <item name="android:windowBackground">#080D18</item>
        <item name="android:navigationBarColor">#080D18</item>
        <item name="android:statusBarColor">#080D18</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="AppThemeLight" parent="@style/BaseAppThemeLight" />
    <style name="AppThemeDark" parent="@style/BaseAppThemeDark" />
</resources>
